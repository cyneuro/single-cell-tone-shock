        "# PV inhibition to soma\n",
        "nc_pv = h.NetCon(pv_stim, pv_syn)\n",
        "\n",
        "som_syn = h.GABA_A_STP(pn.apic[0](0.5))\n",
        "som_stim = h.NetStim()\n",
